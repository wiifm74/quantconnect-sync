name: Push to QuantConnect

on:
  workflow_dispatch:
  workflow_call:

jobs:
  push:
    runs-on: ubuntu-latest
    permissions:
      contents: write

    steps:
      - name: Checkout repo
        uses: actions/checkout@v4

      - name: Push files to QuantConnect
        env:
          QC_USER_ID: ${{ secrets.QC_USER_ID }}
          QC_API_TOKEN: ${{ secrets.QC_API_TOKEN }}
          PROJECT_ID: ${{ vars.QC_PROJECT_ID }}
        run: |
          python3 .github/scripts/qc_sync_logic.py push

      - name: Commit sync state
        run: |
          PROJECT_DIR=$(python3 -c 'import json; print(json.load(open(".github/qc-sync-config.json"))["project_dir"])')

          git config user.name "github-actions"
          git config user.email "actions@github.com"

          git add "$PROJECT_DIR/.qc-sync-state.json" "$PROJECT_DIR/.qc-compare-report.json"

          if git diff --cached --quiet; then
            echo "No state/report changes"
          else
            git commit -m "Update QC sync state after push"
            git push
          fi
